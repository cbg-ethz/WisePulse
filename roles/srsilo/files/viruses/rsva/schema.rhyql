-- RhyDB schema of the wise-rsva instance.
-- Defines all tables of the instance. Every statement ends with ';' at the end of a line.
-- LAPIS keeps a copy of the `data` table in database_config.yaml and reference_genomes.json:
-- change both together (tests/test_schema.py checks they match).

-- References of the default `data` table
tables().limit(1)
  .map({name := 'main', type := 'nucleotide', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'NS1', type := 'amino_acid', sequence := 'MGSNSLSMIKVRLQNLFDNDEVALLKITCYTDKLIQLTNALAKAVIHTIKLNGIVFVHVITSSDICPNNNIVVKSNFTTMPVLQNGGYIWEMMELTHCSQPNGLIDDNCEIKFSKKLSDSTMTNYMNQLSELLGFDLNP*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'NS2', type := 'amino_acid', sequence := 'MDTTHNDTTPQRLMITDMRPLSLETIITSLTRDIITHKFIYLINHECIVRKLDERQATFTFLVNYEMKLLHKVGSTKYKKYTEYNTKYGTFPMPIFINHDGFLECIGIKPTKHTPIIYKYDLNP*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'N', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'P', type := 'amino_acid', sequence := 'MEKFAPEFHGEDANNRATKFLESIKGKFTSPKDPKKKDSIISVNSIDIEVTKESLITSNSTIINPINETDDTVGNKPNYQRKPLVSFKEDPTPSDNPFSKLYKETIETFDNNEEESSYSYEEINDQTNDNITARLDRIDEKLSEILGMLHTLVVASAGPTSARDGIRDAMVGLREEMIEKIRTEALMTNDRLEAMARLRNEESEKMAKDTSDEVSLNPTSEKLNNLLEGNDSDNDLSLEDF*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'M', type := 'amino_acid', sequence := 'METYVNKLHEGSTYTAAVQYNVLEKDDDPASLTIWVPMFQSSMPADLLIKELANVNILVKQISTPKGPSLRVMINSRSAVLAQMPSKFTICANVSLDERSKLAYDVTTPCEIKACSLTCLKSKNMLTTVKDLTMKTLNPTHDIIALCEFENIVTSKKVIIPTYLRSISVRNKDLNTLENITTTEFKNAITNAKIIPYSGLLLVITVTDNKGAFKYIKPQSQFIVDLGAYLEKESIYYVTTNWKHTATRFAIKPMED*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'SH', type := 'amino_acid', sequence := 'MENTSITIEFSSKFWPYFTLIHMITTIISLIIIISIMIAILNKLCEYNVFHNKTFELPRARVNT*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'G', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'F', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'M2-1', type := 'amino_acid', sequence := 'MSRRNPCKFEIRGHCLNGKRCHFSHNYFEWPPHALLVRQNFMLNRILKSMDKSIDTLSEISGAAELDRTEEYALGVVGVLESYIGSINNITKQSACVAMSKLLTELNSDDIKKLRDNEEPNSPKVRVYNTVISYIESNRKNNKQTIHLLKRLPADVLKKTIKNTLDIHKSITINNSKESTVSDTNDHAKNNDTT*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'M2-2', type := 'amino_acid', sequence := 'TTMPKIMILPDKYPCSINSILITSNYRVTMYNQKNTLYINQNNQNSHIYPPDQPFNEIHWTSQDLIDATQNFLQHLGITDDIYTIYILVS*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'L', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);

-- Default table, served by LAPIS
createTable(data, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := main),
  NS1 := aminoAcidSequence(reference := NS1),
  NS2 := aminoAcidSequence(reference := NS2),
  N := aminoAcidSequence(reference := N),
  P := aminoAcidSequence(reference := P),
  M := aminoAcidSequence(reference := M),
  SH := aminoAcidSequence(reference := SH),
  G := aminoAcidSequence(reference := G),
  F := aminoAcidSequence(reference := F),
  "M2-1" := aminoAcidSequence(reference := "M2-1"),
  "M2-2" := aminoAcidSequence(reference := "M2-2"),
  L := aminoAcidSequence(reference := L)
}, primaryKey := readId);
