-- RhyDB schema of the wise-sarsCoV2 instance.
-- Defines all tables of the instance. Every statement ends with ';' at the end of a line.
-- LAPIS keeps a copy of the `data` table in database_config.yaml and reference_genomes.json:
-- change both together (tests/test_schema.py checks they match).

-- References of the default `data` table
tables().limit(1)
  .map({name := 'main', type := 'nucleotide', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'E', type := 'amino_acid', sequence := 'MYSFVSEETGTLIVNSVLLFLAFVVFLLVTLAILTALRLCAYCCNIVNVSLVKPSFYVYSRVKNLNSSRVPDLLV*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'M', type := 'amino_acid', sequence := 'MADSNGTITVEELKKLLEQWNLVIGFLFLTWICLLQFAYANRNRFLYIIKLIFLWLLWPVTLACFVLAAVYRINWITGGIAIAMACLVGLMWLSYFIASFRLFARTRSMWSFNPETNILLNVPLHGTILTRPLLESELVIGAVILRGHLRIAGHHLGRCDIKDLPKEITVATSRTLSYYKLGASQRVAGDSGFAAYSRYRIGNYKLNTDHSSSSDNIALLVQ*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'N', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF1a', type := 'amino_acid', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF1b', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF3a', type := 'amino_acid', sequence := 'MDLFMRIFTIGTVTLKQGEIKDATPSDFVRATATIPIQASLPFGWLIVGVALLAVFQSASKIITLKKRWQLALSKGVHFVCNLLLLFVTVYSHLLLVAAGLEAPFLYLYALVYFLQSINFVRIIMRLWLCWKCRSKNPLLYDANYFLCWHTNCYDYCIPYNSVTSSIVITSGDGTTSPISEHDYQIGGYTEKWESGVKDCVVLHSYFTSDYYQLYSTQLSTDTGVEHVTFFIYNKIVDEPEEHVQIHTIDGSSGVVNPVMEPIYDEPTTTTSVPL*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF6', type := 'amino_acid', sequence := 'MFHLVDFQVTIAEILLIIMRTFKVSIWNLDYIINLIIKNLSKSLTENKYSQLDEEQPMEID*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF7a', type := 'amino_acid', sequence := 'MKIILFLALITLATCELYHYQECVRGTTVLLKEPCSSGTYEGNSPFHPLADNKFALTCFSTQFAFACPDGVKHVYQLRARSVSPKLFIRQEEVQELYSPIFLIVAAIVFITLCFTLKRKTE*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF7b', type := 'amino_acid', sequence := 'MIELSLIDFYLCFLAFLLFLVLIMLIIFWFSLELQDHNETCHA*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF8', type := 'amino_acid', sequence := 'MKFLVFLGIITTVAAFHQECSLQSCTQHQPYVVDDPCPIHFYSKWYIRVGARKSAPLIELCVDEAGSKSPIQYIDIGNYTVSCLPFTINCQEPKLGSLVVRCSFYEDFLEYHDVRVVLDFI*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'ORF9b', type := 'amino_acid', sequence := 'MDPKISEMHPALRLVDPQIQLAVTRMENAVGRDQNNVGPKVYPIILRLGSPLSLNMARKTLNSLEDKAFQLTPIAVQMTKLATTEELPDEFVVVTVK*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'S', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);

-- Default table, served by LAPIS
createTable(data, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date,
  date := string(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := main),
  E := aminoAcidSequence(reference := E),
  M := aminoAcidSequence(reference := M),
  N := aminoAcidSequence(reference := N),
  ORF1a := aminoAcidSequence(reference := ORF1a),
  ORF1b := aminoAcidSequence(reference := ORF1b),
  ORF3a := aminoAcidSequence(reference := ORF3a),
  ORF6 := aminoAcidSequence(reference := ORF6),
  ORF7a := aminoAcidSequence(reference := ORF7a),
  ORF7b := aminoAcidSequence(reference := ORF7b),
  ORF8 := aminoAcidSequence(reference := ORF8),
  ORF9b := aminoAcidSequence(reference := ORF9b),
  S := aminoAcidSequence(reference := S)
}, primaryKey := readId);
