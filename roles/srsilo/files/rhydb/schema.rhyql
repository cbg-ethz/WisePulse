-- RhyDB schema of the shared WisePulse instance (served as wise-rhydb).
-- Defines all tables of the instance. Every statement ends with ';' at the end of a line.
-- Each virus has its own table; its LAPIS instance (if any) reads it via --rhydb.table:
--   covid -> data, rsva -> rsva, rsvb -> rsvb,
--   flua_h1/h3/n1/n2/mp -> flua_h1/h3/n1/n2/mp (no LAPIS)
--   (see roles/srsilo/defaults/main.yml).
-- Reference names are global to the instance, so non-covid references are prefixed with
-- '<virus>_'; the sequence column names (what LAPIS sees) are not.
-- LAPIS keeps a copy of each table in viruses/<virus>/database_config.yaml and
-- reference_genomes.json: change both together (tests/test_schema.py checks they match).

-- ===== covid: references and the `data` table =====
tables().limit(1)
  .map({name := 'main', type := 'nucleotide', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'E', type := 'amino_acid', sequence := 'MYSFVSEETGTLIVNSVLLFLAFVVFLLVTLAILTALRLCAYCCNIVNVSLVKPSFYVYSRVKNLNSSRVPDLLV*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
