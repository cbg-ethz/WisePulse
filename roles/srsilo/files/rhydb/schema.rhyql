createTable(rsvb, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := "rsvb_main"),
  F := aminoAcidSequence(reference := "rsvb_F"),
  G := aminoAcidSequence(reference := "rsvb_G"),
  L := aminoAcidSequence(reference := "rsvb_L"),
  M := aminoAcidSequence(reference := "rsvb_M"),
  "M2-1" := aminoAcidSequence(reference := "rsvb_M2-1"),
  "M2-2" := aminoAcidSequence(reference := "rsvb_M2-2"),
  N := aminoAcidSequence(reference := "rsvb_N"),
  NS1 := aminoAcidSequence(reference := "rsvb_NS1"),
  NS2 := aminoAcidSequence(reference := "rsvb_NS2"),
  P := aminoAcidSequence(reference := "rsvb_P"),
  SH := aminoAcidSequence(reference := "rsvb_SH")
}, primaryKey := readId);
-- ===== flua_h3: references and the `flua_h3` table (no LAPIS instance) =====
-- Influenza A H3 segment, reads aligned to A/Wisconsin/67/2005(H3N2) HA (CY163680.1).
tables().limit(1)
  .map({name := 'flua_h3_main', type := 'nucleotide', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'flua_h3_H3-HA', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
createTable(flua_h3, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := "flua_h3_main"),
  "H3-HA" := aminoAcidSequence(reference := "flua_h3_H3-HA")
}, primaryKey := readId);
-- ===== flua_h1: references and the `flua_h1` table (no LAPIS instance) =====
-- Influenza A H1 segment, reads aligned to A/California/07/2009(H1N1) HA (CY121680.1).
tables().limit(1)
  .map({name := 'flua_h1_main', type := 'nucleotide', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
tables().limit(1)
  .map({name := 'flua_h1_H1-HA', type := 'amino_acid', sequence := '*'})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
createTable(flua_h1, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := "flua_h1_main"),
  "H1-HA" := aminoAcidSequence(reference := "flua_h1_H1-HA")
}, primaryKey := readId);
