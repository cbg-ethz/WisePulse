-- ===== flua_mp: references and the `flua_mp` table (no LAPIS instance) =====
-- Influenza A MP segment, reads aligned to the V-pipe MP consensus (mp.align_consensus).
-- Nucleotide only: the protein column names of MP reads are not known yet.
tables().limit(1)
  .map({name := 'flua_mp_main', type := 'nucleotide', sequence := ''})
  .project({name, type, sequence})
  .insertInto(reference_genomes);
createTable(flua_mp, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := "flua_mp_main")
}, primaryKey := readId);
