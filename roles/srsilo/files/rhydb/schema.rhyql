createTable(rsva, {
  sampleId := string(generateIndex := true),
  batchId := string(generateIndex := true),
  locationCode := string(generateIndex := true),
  samplingDate := date(generateIndex := true),
  locationName := string(generateIndex := true),
  readId := string,
  sr2siloVersion := string(generateIndex := true),
  main := nucleotideSequence(reference := "rsva_main"),
  NS1 := aminoAcidSequence(reference := "rsva_NS1"),
  NS2 := aminoAcidSequence(reference := "rsva_NS2"),
  N := aminoAcidSequence(reference := "rsva_N"),
  P := aminoAcidSequence(reference := "rsva_P"),
  M := aminoAcidSequence(reference := "rsva_M"),
  SH := aminoAcidSequence(reference := "rsva_SH"),
  G := aminoAcidSequence(reference := "rsva_G"),
  F := aminoAcidSequence(reference := "rsva_F"),
  "M2-1" := aminoAcidSequence(reference := "rsva_M2-1"),
  "M2-2" := aminoAcidSequence(reference := "rsva_M2-2"),
  L := aminoAcidSequence(reference := "rsva_L")
}, primaryKey := readId);

