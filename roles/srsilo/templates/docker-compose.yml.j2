name: wise-srsilo
services:
  rhydb:
    container_name: {{ srsilo_rhydb_container_name }}
    image: ghcr.io/rhyorg/rhydb:0.17.4
    mem_limit: {{ srsilo_rhydb_memory_limit }}
    restart: unless-stopped
    ports:
      - {{ srsilo_rhydb_port }}:8081
    command: api --api-threads-for-http-connections 96 --api-max-queued-http-connections 1024
    volumes:
      - type: bind
        source: {{ srsilo_rhydb_output }}
        target: /data
        read_only: true
      - type: bind
        source: {{ srsilo_rhydb_path }}/logs
        target: /app/logs
        read_only: false
    stop_grace_period: 0s
{% for virus in srsilo_enabled_viruses %}
{% set meta = srsilo_viruses[virus] %}
{% set config_path = srsilo_base_path ~ '/' ~ virus ~ '/config' %}

  lapis-{{ virus }}:
    container_name: {{ meta.instance_name }}-lapis
    image: ghcr.io/genspectrum/lapis:0.9.2
    restart: unless-stopped
    ports:
      - {{ meta.lapis_port }}:8080
    environment:
      # Cache size tuned to avoid GC pressure, more predictable maximum cache size (see #147)
      - SPRING_CACHE_CAFFEINE_SPEC=maximumSize=500000
    command: --rhydb.url=http://rhydb:8081 --rhydb.table={{ meta.table }}
    volumes:
      - type: bind
        source: {{ config_path }}/database_config.yaml
        target: /workspace/database_config.yaml
        read_only: true
      - type: bind
        source: {{ config_path }}/reference_genomes.json
        target: /workspace/reference_genomes.json
        read_only: true
    stop_grace_period: 0s
{% endfor %}
