server {
    server_name rhydb.{{ nginx_domain_name }};

    # RhyDB's result-ordering response header grows 62 bytes per orderBy()
    # column and can exceed nginx's default 4k/8k proxy buffers, causing
    # nginx to drop the response (see issue #266).
    proxy_buffer_size 64k;
    proxy_buffers 4 64k;
    proxy_busy_buffers_size 128k;

    # Serves the COVID RhyDB instance at the root path
    location / {
        proxy_pass http://silo-covid;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods * always;
        add_header Access-Control-Allow-Headers * always;
    }

    listen 443 ssl http2; # managed by Certbot
    ssl_certificate {{ nginx_rhydb_ssl_certificate_path }}; # managed by Certbot
    ssl_certificate_key {{ nginx_rhydb_ssl_certificate_key_path }}; # managed by Certbot
    include /etc/nginx/snippets/ssl-params.conf;
}

server {
    if ($host = rhydb.{{ nginx_domain_name }}) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name rhydb.{{ nginx_domain_name }};
    return 404; # managed by Certbot
}
