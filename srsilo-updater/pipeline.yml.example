# srSILO updater configuration
# Deployed by Ansible from group_vars/srsilo/main.yml values.
# Edit group_vars, not this file directly.

base_path: /opt/srsilo
tools_path: /opt/srsilo/tools
api_base_url: https://api.db.wasap.genspectrum.org

retention_days: 7
retention_min_keep: 2

enabled_viruses:
  - covid
  - rsva
  - rsvb

viruses:
  covid:
    organism: covid
    table: data           # table of the shared RhyDB instance
    fetch_days: 90
    fetch_max_reads: 172500000
    chunk_size: 1000000
  rsva:
    organism: rsva
    table: rsva           # table of the shared RhyDB instance
    fetch_days: 90
    fetch_max_reads: 50000000
    chunk_size: 500000
  rsvb:
    organism: rsvb
    table: rsvb           # table of the shared RhyDB instance
    fetch_days: 90
    fetch_max_reads: 50000000
    chunk_size: 500000
